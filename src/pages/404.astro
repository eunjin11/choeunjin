---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없어요">
	<section class="not-found">
		<p class="code">404</p>
		<h1>페이지를 찾을 수 없어요</h1>
		<p class="desc">주소가 바뀌었거나 없는 페이지예요.</p>
		<a href="/">← 블로그 홈으로</a>
	</section>
</BaseLayout>

<style>
	.not-found {
		padding: 64px 0;
	}
	.code {
		color: var(--text-muted);
		font-size: var(--font-sm);
		font-variant-numeric: tabular-nums;
	}
	h1 {
		margin-top: 8px;
		font-size: var(--font-2xl);
		font-weight: 700;
		letter-spacing: -0.03em;
	}
	.desc {
		margin-top: 8px;
		color: var(--text-sub);
	}
	a {
		display: inline-block;
		margin-top: 32px;
		font-size: var(--font-sm);
		color: var(--text-muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--text);
	}
</style>
