---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate } from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout title="소개">
	<section class="profile">
		<div class="profile-text">
			<h1>조은진</h1>
			<p class="tagline">팀원을 행복하게 만들고 싶은 프론트엔드 개발자 조은진입니다.</p>
			<dl class="contacts">
				<div>
					<dt>이메일</dt>
					<dd>
						<a href="mailto:whdmswls9207@gmail.com">whdmswls9207@gmail.com</a>
					</dd>
				</div>
				<div>
					<dt>GitHub</dt>
					<dd>
						<a href="https://github.com/eunjin11">github.com/eunjin11</a>
					</dd>
				</div>
			</dl>
		</div>
		<img class="avatar" src="/profile.webp" alt="조은진 프로필 사진" width="176" height="176" />
	</section>

	<hr />

	<section>
		<h2 class="section-title">자기 소개</h2>
		<div class="intro">
			<p>쉽고 편한 개발을 위한 개발 도구를 만들고 있어요. 내가 만든 도구로 팀원들이 행복하게 개발하기를 바랍니다.</p>
			<p>프론트엔드 크로스 플랫폼 기술인 Lynx의 플랫폼 개발과 프로덕트 개발을 함께 하고 있습니다.</p>
			<p>
				좋아하는 것은 남들이 망할 것 같다고 생각하는 일에 도전하기, 어떻게든 되게 만들기, 커피 마시기, 글쓰기, 만화
				보기, 영상 편집 등이 있어요.
			</p>
		</div>
	</section>

	<hr />

	<section>
		<h2 class="section-title">이력</h2>
		<ul class="timeline">
			<li>
				<span class="when">2026.04 —</span>
				<span>당근 프론트엔드코어 팀 / 나의당근 팀 겸직</span>
			</li>
			<li>
				<span class="when">2025.12</span>
				<span>당근 프론트엔드코어 팀 인턴</span>
			</li>
		</ul>
	</section>

	<hr />

	<section>
		<h2 class="section-title">오픈소스 프로젝트</h2>
		<ul class="projects">
			<li>
				<span class="name">lynx-console</span>
				<span class="desc">Lynx 앱 안에서 콘솔·네트워크 로그를 바로 보는 개발자 도구</span>
				<a href="https://github.com/daangn/lynx-console">GitHub</a>
			</li>
			<li>
				<span class="name">ddo-dnd</span>
				<span class="desc">꼭 필요한 기능만 있는 가벼운 드래그앤드롭 라이브러리</span>
				<a href="https://github.com/eunjin11/ddo-dnd">GitHub</a>
			</li>
		</ul>
	</section>

	<hr />

	<section>
		<div class="section-head">
			<h2 class="section-title">최근 글</h2>
			<a href="/" class="more">
				전체 보기 →
			</a>
		</div>
		<ul class="post-list">
			{posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>{post.data.title}</a>
					<time class="muted" datetime={post.data.date.toISOString()}>
						{formatDate(post.data.date)}
					</time>
				</li>
			))}
		</ul>
	</section>
</BaseLayout>

<style>
	.profile {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 32px;
	}
	h1 {
		font-size: var(--font-3xl);
		font-weight: 800;
		letter-spacing: -0.03em;
	}
	.tagline {
		margin-top: 6px;
		font-size: var(--font-xl);
		color: var(--text);
	}
	.contacts {
		margin: 24px 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 4px 32px;
		font-size: var(--font-sm);
	}
	.contacts div {
		display: flex;
		gap: 8px;
	}
	.contacts dt {
		font-weight: 600;
	}
	.contacts dd {
		margin: 0;
		color: var(--text-sub);
	}
	.avatar {
		width: 176px;
		height: 176px;
		object-fit: cover;
		border-radius: 20px;
		flex-shrink: 0;
	}
	@media (max-width: 720px) {
		.profile {
			flex-direction: column-reverse;
		}
		.avatar {
			width: 120px;
			height: 120px;
		}
	}
	.intro {
		display: flex;
		flex-direction: column;
		gap: 20px;
		color: var(--text);
	}
	/* 이력과 오픈소스 목록이 같은 열에 맞춰지도록 왼쪽 라벨 너비와 간격을 공유해요. */
	.timeline,
	.projects {
		--label-width: 104px;
		--label-gap: 24px;
	}
	.timeline {
		list-style: none;
		padding: 0;
	}
	.timeline li {
		display: flex;
		align-items: baseline;
		gap: var(--label-gap);
	}
	.timeline li + li {
		margin-top: 8px;
	}
	.when {
		flex-shrink: 0;
		width: var(--label-width);
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
	}
	.projects {
		list-style: none;
		padding: 0;
	}
	.projects li {
		display: flex;
		align-items: baseline;
		gap: var(--label-gap);
	}
	.projects li + li {
		margin-top: 8px;
	}
	.projects .name {
		flex-shrink: 0;
		width: var(--label-width);
		font-weight: 600;
	}
	.projects .desc {
		flex: 1;
	}
	.projects a {
		flex-shrink: 0;
		font-size: var(--font-sm);
		color: var(--text-muted);
	}
	@media (max-width: 720px) {
		.projects li {
			flex-wrap: wrap;
			gap: 2px var(--label-gap);
		}
		.projects .desc {
			flex-basis: 100%;
			order: 1;
		}
	}
	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
	}
	.more {
		font-size: var(--font-sm);
		color: var(--text-muted);
		text-decoration: none;
	}
	.post-list {
		list-style: none;
		padding: 0;
	}
	.post-list li {
		display: flex;
		justify-content: space-between;
		gap: 16px;
	}
	.post-list li + li {
		margin-top: 8px;
	}
</style>
