{
  "useTabs": true,
  "singleQuote": true,
  "printWidth": 120,
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": "*.astro",
      "options": { "parser": "astro" }
    },
    {
      "files": ["*.md", "*.json", "*.yml"],
      "options": { "useTabs": false }
    }
  ]
}
